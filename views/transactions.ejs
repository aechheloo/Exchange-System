<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giao dịch</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="topbar">
        <div>
            <h1>Giao dịch</h1>
            <p>Tối đa 300 giao dịch gần nhất</p>
        </div>
        <nav>
            <a href="/admin">Nhóm</a>
            <a href="/admin/transactions">Giao dịch</a>
            <a href="/admin/staff">Nhân viên</a>
        </nav>
    </header>

    <main class="container">
        <section class="panel">
            <form class="filter" method="get">
                <label>
                    Chọn nhóm
                    <select name="group_id">
                        <option value="">Tất cả nhóm</option>
                        <% groups.forEach((group) => { %>
                            <option value="<%= group.id %>" <%= selectedGroupId === group.id ? "selected" : "" %>>
                                <%= group.group_name %>
                            </option>
                        <% }) %>
                    </select>
                </label>
                <button type="submit">Lọc</button>
            </form>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Nhóm</th>
                            <th>Loại</th>
                            <th>Số tiền</th>
                            <th>Phí</th>
                            <th>Còn lại</th>
                            <th>User ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% transactions.forEach((tx) => { %>
                            <tr>
                                <td><%= new Date(tx.created_at).toLocaleString("vi-VN", { timeZone: "Asia/Ho_Chi_Minh" }) %></td>
                                <td><%= tx.group_name %></td>
                                <td><%= tx.type === "IN" ? "Tiền vào" : tx.type === "OUT" ? "Tiền ra" : "Điều chỉnh" %></td>
                                <td><%= formatMoney(tx.amount) %></td>
                                <td><%= formatMoney(tx.fee_amount) %> (<%= formatPercent(tx.fee_percent) %>%)</td>
                                <td class="<%= Number(tx.balance_after) < 0 ? 'negative' : 'positive' %>"><%= formatMoney(tx.balance_after) %></td>
                                <td><%= tx.telegram_user_id %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
